{
   "action": {
      "default_title": "Click to open panel"
   },
   "background": {
      "service_worker": "background.iife.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "content-ui/index.iife.js" ],
      "matches": [ "http://*/*", "https://*/*", "file:///*" ]
   } ],
   "default_locale": "en",
   "description": "Chrome extension to help convert html web page to elementor widget",
   "icons": {
      "256": "icon-256.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "HTML To Elementor",
   "permissions": [ "storage", "activeTab", "debugger", "clipboardWrite" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.3",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*", "file:///*" ],
      "resources": [ "*.js", "*.css", "*.svg", "icon-256.png" ]
   } ]
}
