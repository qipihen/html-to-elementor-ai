{
   "action": {
      "default_title": "Open Elementor Capture Hub"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [
      {
         "js": [
            "content-ui/index.iife.js",
            "content-ui/ai-hub.js"
         ],
         "matches": [
            "http://*/*",
            "https://*/*",
            "file:///*"
         ]
      }
   ],
   "default_locale": "en",
   "description": "Capture page blocks and convert HTML/CSS into Elementor-ready payloads with AI-assisted workflow",
   "icons": {
      "256": "icon-256.png"
   },
   "manifest_version": 3,
   "name": "Elementor AI Capture Studio",
   "options_page": "options/options.html",
   "permissions": [
      "storage",
      "activeTab",
      "debugger",
      "clipboardWrite"
   ],
   "version": "1.1.3",
   "web_accessible_resources": [
      {
         "matches": [
            "*://*/*",
            "file:///*"
         ],
         "resources": [
            "*.js",
            "*.css",
            "*.svg",
            "icon-256.png"
         ]
      }
   ]
}
